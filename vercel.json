{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/convites/nivel-3/presentes.html",
      "destination": "/convite/presentes.html",
      "permanent": false
    },
    {
      "source": "/convites/:path*",
      "destination": "/convite/",
      "permanent": false
    },
    {
      "source": "/convites",
      "destination": "/convite/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/convite/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
